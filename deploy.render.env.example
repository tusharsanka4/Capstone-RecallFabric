# Safe placeholders only. Configure Render secrets; do not copy over local env files.
PORT=8000
RECALLFABRIC_ENVIRONMENT=production
RECALLFABRIC_AUTH_ENABLED=true
RECALLFABRIC_ALLOW_PUBLIC_SIGNUP=false
RECALLFABRIC_ADMIN_TOKEN=REPLACE_WITH_RANDOM_ADMIN_SECRET
RECALLFABRIC_DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT.neon.tech/DATABASE?sslmode=require
RECALLFABRIC_DB_SSLMODE=require
RECALLFABRIC_RUN_MIGRATIONS=false
RECALLFABRIC_WORKERS=1
RECALLFABRIC_MCP_PUBLIC_URL=https://YOUR-SERVICE.onrender.com
RECALLFABRIC_OAUTH_AUTHORIZATION_SERVER=https://YOUR-SERVICE.onrender.com
RECALLFABRIC_OAUTH_SCOPES=memory:read memory:write
RECALLFABRIC_LLM_PROVIDER=openai
RECALLFABRIC_CHAT_PROVIDER=openai
RECALLFABRIC_EXTRACTION_PROVIDER=openai
RECALLFABRIC_OPENAI_API_KEY=REPLACE_WITH_PROVIDER_KEY
RECALLFABRIC_OPENAI_MODEL=REPLACE_WITH_SUPPORTED_MODEL
RECALLFABRIC_EMBEDDING_PROVIDER=fastembed
RECALLFABRIC_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RECALLFABRIC_EMBEDDING_CACHE_DIR=/app/.model-cache
# Use the existing encryption key if memories are encrypted; otherwise leave unset.
# RECALLFABRIC_ENCRYPTION_KEY=REPLACE_WITH_VALID_PRESERVED_FERNET_KEY
