RECALLFABRIC_APP_NAME=RecallFabric
RECALLFABRIC_ENVIRONMENT=development
RECALLFABRIC_LOG_LEVEL=INFO
# Local Database Settings (Docker default)
RECALLFABRIC_DB_HOST=127.0.0.1
RECALLFABRIC_DB_PORT=5432
RECALLFABRIC_DB_NAME=recallfabric
RECALLFABRIC_DB_USER=recallfabric
RECALLFABRIC_DB_PASSWORD=recallfabric_local

# Managed Cloud PostgreSQL Settings (Neon / Supabase)
# When RECALLFABRIC_DATABASE_URL is set, it takes precedence over DB_HOST/PORT/NAME/USER/PASSWORD.
# Supports postgres://, postgresql://, or postgresql+psycopg://.
#
# Examples:
# Neon (Pooled connection string for app runtime):
# RECALLFABRIC_DATABASE_URL=postgresql://user:password@ep-cool-butterfly-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Neon (Direct connection string for migrations - run alembic upgrade head with this):
# RECALLFABRIC_DATABASE_URL=postgresql://user:password@ep-cool-butterfly-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Supabase (Pooled connection string - transaction pooler on port 6543):
# RECALLFABRIC_DATABASE_URL=postgresql://postgres.yourproject:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# Supabase (Direct connection string for migrations on port 5432):
# RECALLFABRIC_DATABASE_URL=postgresql://postgres:password@db.yourproject.supabase.co:5432/postgres?sslmode=require
#
# NOTE ON TRANSACTION POOLERS & PREPARED STATEMENTS:
# Cloud providers often use transaction poolers (e.g. PgBouncer or Supavisor).
# In transaction pooling mode, named prepared statements cannot persist across transactions.
# Always run Alembic migrations (alembic upgrade head) against the DIRECT connection string.
# The application connection pool settings below keep connections healthy in serverless environments.
#
# RECALLFABRIC_DATABASE_URL=
RECALLFABRIC_DB_SSLMODE=prefer
RECALLFABRIC_DB_POOL_SIZE=5
RECALLFABRIC_DB_MAX_OVERFLOW=10
RECALLFABRIC_DB_POOL_RECYCLE=1800
RECALLFABRIC_DB_POOL_PRE_PING=true
RECALLFABRIC_EMBEDDING_PROVIDER=fastembed
RECALLFABRIC_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RECALLFABRIC_EMBEDDING_CACHE_DIR=.model-cache
RECALLFABRIC_EMBEDDING_THREADS=2
# Hosted Embedding Provider Settings (low-RAM environments):
# RECALLFABRIC_EMBEDDING_PROVIDER=openai  # or gemini
RECALLFABRIC_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RECALLFABRIC_OPENAI_EMBEDDING_DIMENSIONS=1536
RECALLFABRIC_GEMINI_EMBEDDING_MODEL=text-embedding-004
RECALLFABRIC_GEMINI_EMBEDDING_DIMENSIONS=768

# Server, Worker & Production Settings
RECALLFABRIC_WORKERS=1
RECALLFABRIC_RUN_MIGRATIONS=false
RECALLFABRIC_CORS_ORIGINS=*
RECALLFABRIC_LLM_BASE_URL=http://127.0.0.1:11434/v1
RECALLFABRIC_EXTRACTION_MODEL=qwen2.5:0.5b
RECALLFABRIC_LLM_API_KEY=ollama
RECALLFABRIC_LLM_TIMEOUT=30.0
RECALLFABRIC_EXTRACTION_TEMPERATURE=0.0
RECALLFABRIC_EXTRACTION_MIN_IMPORTANCE=0.6
RECALLFABRIC_EXTRACTION_MIN_CONFIDENCE=0.5
RECALLFABRIC_RETRIEVAL_MIN_SIMILARITY=0.4
RECALLFABRIC_RANK_W_RELEVANCE=0.40
RECALLFABRIC_RANK_W_IMPORTANCE=0.20
RECALLFABRIC_RANK_W_CONFIDENCE=0.10
RECALLFABRIC_RANK_W_RECENCY=0.15
RECALLFABRIC_RANK_W_FREQUENCY=0.15
RECALLFABRIC_RANK_RECENCY_HALF_LIFE_DAYS=14.0
RECALLFABRIC_RANK_FREQUENCY_CAP=100
RECALLFABRIC_RANK_CANDIDATE_MULTIPLIER=3
RECALLFABRIC_CHAT_MODEL=qwen2.5:0.5b
RECALLFABRIC_CONTEXT_MAX_CHARS=2000
RECALLFABRIC_DEDUPE_THRESHOLD=0.92
RECALLFABRIC_CONFLICT_MIN_SIMILARITY=0.70
RECALLFABRIC_EXTRACTION_MAX_SNIPPET_CHARS=200
RECALLFABRIC_LLM_PROVIDER=ollama
RECALLFABRIC_CHAT_PROVIDER=
RECALLFABRIC_EXTRACTION_PROVIDER=
RECALLFABRIC_OPENAI_API_KEY=
RECALLFABRIC_OPENAI_BASE_URL=https://api.openai.com/v1
RECALLFABRIC_OPENAI_MODEL=gpt-4o-mini
RECALLFABRIC_ANTHROPIC_API_KEY=
RECALLFABRIC_ANTHROPIC_BASE_URL=https://api.anthropic.com
RECALLFABRIC_ANTHROPIC_MODEL=claude-3-haiku-20240307
RECALLFABRIC_GEMINI_API_KEY=
RECALLFABRIC_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
RECALLFABRIC_GEMINI_MODEL=gemini-1.5-flash
RECALLFABRIC_AUTH_ENABLED=false
RECALLFABRIC_ADMIN_TOKEN=
RECALLFABRIC_ENCRYPTION_KEY=
RECALLFABRIC_RATE_LIMIT_RPS=20.0
RECALLFABRIC_RATE_LIMIT_BURST=40
RECALLFABRIC_MAX_REQUEST_SIZE_BYTES=1048576
RECALLFABRIC_API_KEY=
RECALLFABRIC_MCP_TRANSPORT=stdio
RECALLFABRIC_MCP_HOST=127.0.0.1
RECALLFABRIC_MCP_PORT=8001
RECALLFABRIC_MCP_USER_ID=
RECALLFABRIC_PROXY_ALLOWED_UPSTREAMS=https://api.openai.com,https://api.anthropic.com,https://generativelanguage.googleapis.com,http://127.0.0.1,http://localhost,*
RECALLFABRIC_PROXY_DEFAULT_UPSTREAM_URL=https://api.openai.com/v1
RECALLFABRIC_PROXY_EXTRACT_BY_DEFAULT=false
